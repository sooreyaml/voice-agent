# --- OpenAI ---------------------------------------------------------------
# platform.openai.com > API keys
OPENAI_API_KEY=replace-with-openai-api-key

# platform.openai.com > Settings > Project > Webhooks
# Create a webhook subscribed to "realtime.call.incoming" and copy its signing secret.
OPENAI_WEBHOOK_SECRET=replace-with-openai-webhook-secret

# Your OpenAI project id (Settings > Project > General). Needed for the SIP URI.
OPENAI_PROJECT_ID=proj_replace_with-project-id

# gpt-realtime-2.1-mini is ~3x cheaper than the flagship and is plenty for
# front-desk Q&A. Switch to gpt-realtime-2.1 if you need better reasoning.
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin

# Caller-side transcription is billed separately. Turn it off to save money if
# you do not need a written record of what the caller said.
TRANSCRIBE_CALLER=true
TRANSCRIBE_MODEL=whisper-1

# Cheap text model used once per call to write the post-call summary.
SUMMARY_MODEL=gpt-5.6-luna

# --- App ------------------------------------------------------------------
# Canonical profile template used only by explicit provisioning commands.
BUSINESSES_DIR=businesses

# Call history. DATABASE_PATH is the local SQLite file; DATABASE_URL wins when
# set and is what hosts with an ephemeral disk (Railway, Fly, Render) inject.
DATABASE_PATH=data/calls.sqlite3
DATABASE_URL=
# Shared webhook idempotency, API-key limits, and active-call heartbeats. Local
# development can leave this blank; staging/production must provide Redis.
REDIS_URL=

# --- Auth / management API ---------------------------------------------
# "development" relaxes guardrails: non-secure cookies, /docs visible, and an
# insecure fallback token key. Use "staging" or "production" anywhere real.
ENVIRONMENT=development
# Keys the at-rest hash of session and email tokens. Generate with:
#   openssl rand -hex 32
# Required when ENVIRONMENT is staging or production.
AUTH_SESSION_SECRET=
# Dedicated bearer token for the organization seeding endpoint. Generate with:
#   openssl rand -hex 32
SEED_API_TOKEN=
# Public service base URL, used to build links in authentication emails.
APP_BASE_URL=http://localhost:8000
# Reserved for gating writes on a verified email; not enforced yet.
REQUIRE_EMAIL_VERIFICATION=false

# --- Transactional email (Resend) -----------------------------------------
# Create an API key at resend.com/api-keys and verify the sender's domain.
# Both values are required outside development. With either value blank in
# development, auth and invitation links are written to the log instead.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=Call Agent <notifications@example.com>

# Encrypts third-party integration credentials (e.g. calendar API keys) at rest.
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when ENVIRONMENT is staging or production; development derives a
# throwaway key so local runs need no value.
INTEGRATION_ENCRYPTION_KEY=

# Optional single, unsigned, no-retry fallback for post-call summaries (Zapier,
# Make, your CRM). Registered per-organization webhook endpoints are the real,
# signed, retrying path. A business can override this with its own
# notify_webhook key.
NOTIFY_WEBHOOK_URL=

# --- Outbound webhooks (background worker: python -m app.worker) ----------
# Per-attempt HTTP timeout, and how many times a delivery retries before it is
# dead-lettered. Defaults are fine for most setups.
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=6

# --- Public REST API ----------------------------------------------------
# Requests per minute per API key before a 429. 0 disables the limit.
API_KEY_RATE_LIMIT_PER_MINUTE=120

# --- Twilio managed telephony ---------------------------------------------
# Platform credentials. Customers never receive these and never need a Twilio
# account: numbers are bought into a pre-warmed pool and handed out at signup.
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token

# --- Number pool --------------------------------------------------------
# Keep this many numbers ready so signup can assign one instantly. The worker
# buys more when it runs low. Set 0 to disable the refill job (dev / self-host).
NUMBER_POOL_TARGET=10
# ISO country the pool buys in. US only for now (no regulatory bundle).
NUMBER_POOL_COUNTRY=US
# A recycled number that was ever live on a call waits this long before reuse.
NUMBER_QUARANTINE_DAYS=30

# --- Stripe billing (off for now) ---------------------------------------
# Billing is disabled: signup creates a working tenant with a live number and no
# subscription. Internal call usage and cost accounting still run.
# To turn billing on: set BILLING_ENABLED=true and fill in the STRIPE_* values.
# The app then seeds one billing plan from STRIPE_PRICE_ID at startup and signup
# opens a Stripe Checkout that captures the card.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_METER_EVENT_NAME=call_seconds
DEFAULT_BILLING_PLAN_CODE=starter
# Only used when billing is on:
# a signup that never completes checkout is reaped after this many hours;
# a past-due subscription keeps answering this many days before suspension.
SIGNUP_CHECKOUT_GRACE_HOURS=24
DUNNING_GRACE_DAYS=7
