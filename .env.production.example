# Public hostname whose DNS A/AAAA record points to the VPS.
APP_DOMAIN=voice.example.com

# Generate with: docker run --rm -it caddy:2-alpine caddy hash-password
ADMIN_USER=admin
# Keep a real bcrypt hash single-quoted so Docker Compose treats its $ literally.
ADMIN_PASSWORD_HASH='replace-with-caddy-bcrypt-hash'

# Generate a URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value

# Docker Compose supplies this automatically; set it explicitly on other hosts.
REDIS_URL=redis://redis:6379/0

# Keys the at-rest hash of API session and email tokens. Required.
# openssl rand -hex 32
AUTH_SESSION_SECRET=replace-with-a-long-random-hex-value

# Dedicated bearer token used only by the GitHub organization-seeding workflow.
# Generate with: openssl rand -hex 32
SEED_API_TOKEN=replace-with-a-different-long-random-hex-value

# Encrypts third-party integration credentials (calendar API keys, etc.) at rest.
# Required. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=replace-with-a-fernet-key

# OpenAI project credentials. The webhook must subscribe to
# realtime.call.incoming at https://APP_DOMAIN/openai/webhook.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_WEBHOOK_SECRET=replace-with-openai-webhook-secret
OPENAI_PROJECT_ID=proj_replace_with_project_id

REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
TRANSCRIBE_CALLER=true
TRANSCRIBE_MODEL=whisper-1
SUMMARY_MODEL=gpt-5.6-luna

BUSINESSES_DIR=businesses
NOTIFY_WEBHOOK_URL=

ENVIRONMENT=production
APP_BASE_URL=https://voice.example.com
REQUIRE_EMAIL_VERIFICATION=false

# Platform credentials used by the managed-telephony API and operational scripts.
# Customer organizations never receive these values.
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token

# Set false to disable billing routes, Stripe webhooks, and spend-limit blocks.
BILLING_ENABLED=true
# Platform subscription billing and signed POST /webhooks/stripe deliveries.
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
